{
  "name": "claude-marketplace",
  "version": "1.1.0",
  "description": "Collection of Claude Code plugins and Pi extensions",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "bash test/run.sh",
    "test:unit": "bash test/run.sh unit",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-marketplace.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/observe-pr.ts",
      "./extensions/devin-delegate.ts",
      "./extensions/orca-orchestration.ts",
      "./extensions/pr-tasks.ts",
      "./extensions/tools.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "*"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
