{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$DEVIN_PLUGIN_ROOT/scripts/session-init.mjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$DEVIN_PLUGIN_ROOT/scripts/notify-changes.mjs\"",
          "timeout": 30
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node \"$DEVIN_PLUGIN_ROOT/scripts/check-settle.mjs\"",
          "timeout": 300
        }
      ]
    }
  ]
}
