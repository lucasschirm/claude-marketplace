{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"extensions/**",
			"agy-acp/**",
			"test/**",
			"scripts/**",
			// A plugin's own code: hook scripts and the MCP server it ships. `plugins/*/lib/**` is
			// deliberately absent - those files are byte-identical vendored copies of extensions/lib/,
			// kept honest by scripts/sync-plugin-libs.mjs and gated by `npm run validate`. Linting them
			// would count the same debt twice and report every fix at two call sites.
			"plugins/*/scripts/**",
			"plugins/*/src/**",
			// Generated by `npm run qa:baseline`: its shape is whatever JSON.stringify produces, and a
			// formatter restyling a data file is noise in the one file whose diff must stay readable.
			"!scripts/quality-baseline.json",
			// The spike's prototype files are the recorded behavioural specification, not repo code:
			// reformatting or re-linting them would edit the record they are.
			"!agy-acp/test/fixtures/reference/**"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 140
	},
	"assist": {
		"enabled": false,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			// Rules below are grouped by what they cost to keep, not by what they catch:
			//
			//   "error"  - the repo is at zero today, so the gate holds the line for free. A new
			//              violation is a new decision, and it fails the build rather than growing
			//              a count nobody reads.
			//   "warn"   - real debt that exists today. `npm run check` ratchets each count against
			//              scripts/quality-baseline.json, so these may only shrink.
			//   "off"    - measured, judged to cost more than it returns, and the reason recorded.
			//
			// Severities were set from a full survey of all 56 performance/complexity rules over
			// extensions/, agy-acp/, test/, scripts/ and the plugins' own code, not from defaults.
			"performance": {
				// Zero today. noAccumulatingSpread is the O(n^2) `[...acc, x]` reduce, which is the one
				// performance mistake in this codebase's shape that would actually hurt at runtime.
				"noAccumulatingSpread": "error",
				"noDynamicNamespaceImportAccess": "error",
				// OFF, deliberately. The rule is about hidden-class deoptimisation, which needs a hot path to
				// matter; all 16 sites here are one-shot teardown. 14 are `delete (globalThis as any).__PI_*__`,
				// where the fix (`= undefined`) would leave the key on globalThis forever instead of removing
				// it - the opposite of the ownership the globalThisOwnership invariant exists to enforce. The
				// other 2 drop a section from `event.systemPromptOptions.sections`, where an `undefined` left
				// behind is a section serialised into the system prompt. Measured, rejected, recorded.
				"noDelete": "off",
				// 89 sites, and most are deliberate: cleanup that must finish in order, and `gh` calls
				// paced to stay inside GitHub's rate limit. Parallelising them is a behaviour change,
				// so this is debt to argue site by site, not a switch to flip.
				"noAwaitInLoops": "warn",
				// 434 sites, 251 of them in the trees lint reached for the first time here (211 in test/
				// alone). A regex literal rebuilt per call is a real cost in a hot path and noise everywhere
				// else; warn keeps it visible and ratcheted.
				"useTopLevelRegex": "warn",
				// 185 sites (101 in test/), nearly all `import * as path from "node:path"`. The rule exists to help a
				// bundler tree-shake, which this repo never does: Pi loads these files directly. Kept
				// visible rather than off because a namespace import of a *local* module is worth seeing.
				"noNamespaceImport": "warn"
			},
			"complexity": {
				// 65 functions above 20 today (P1 decision D3b): reported here, ratcheted by check-quality,
				// instead of a hand-rolled "lines per declaration" counter.
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": {
						"maxAllowedComplexity": 20
					}
				},
				// 8 functions over 120 today, and they are two different problems. Four are extension entry
				// points - devin-delegate 1505 lines, observe-pr 1118, orca-orchestration 980, pr-tasks 798 -
				// each one closure holding the whole extension, which needs a decomposition design before a
				// line count can be met. The other four are ordinary long functions (137, 140, 135, 159) that
				// can be split on their own. The limit is set where it separates "long" from "the whole
				// extension is one function", and the count is ratcheted down.
				//
				// The override at the foot of this file exempts test/ and agy-acp/test/, where 20 more
				// functions exceed 120 lines. That is 28 in the gated trees: 8 ratcheted, 20 exempt.
				"noExcessiveLinesPerFunction": {
					"level": "warn",
					"options": {
						"maxLines": 120,
						"skipBlankLines": true
					}
				},
				// No function anywhere takes more than 6 parameters, so 6 is the line already held.
				// biome's default of 4 would have reported 34 call signatures as debt on day one.
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 6
					}
				},
				// Zero today, kept that way.
				"noAdjacentSpacesInRegex": "error",
				"noArguments": "error",
				"noCommaOperator": "error",
				"noDivRegex": "error",
				"noEmptyTypeParameters": "error",
				"noExcessiveNestedTestSuites": "error",
				"noFlatMapIdentity": "error",
				"noForEach": "error",
				"noImplicitCoercions": "error",
				"noRedundantDefaultExport": "error",
				"noStaticOnlyClass": "error",
				"noThisInStatic": "error",
				"noUselessCatch": "error",
				"noUselessConstructor": "error",
				"noUselessContinue": "error",
				"noUselessEmptyExport": "error",
				"noUselessEscapeInRegex": "error",
				"noUselessLabel": "error",
				"noUselessLoneBlockStatements": "error",
				"noUselessRename": "error",
				"noUselessStringRaw": "error",
				"noUselessSwitchCase": "error",
				"noUselessTernary": "error",
				"noUselessThisAlias": "error",
				"noUselessTypeConstraint": "error",
				"noUselessUndefinedInitialization": "error",
				"useArrowFunction": "error",
				"useDateNow": "error",
				"useFlatMap": "error",
				"useIndexOf": "error",
				"useNumericLiterals": "error",
				"useRegexLiterals": "error",
				"useSimpleNumberKeys": "error",
				"useWhile": "error",
				// Small counts, fixed in the commit that turned each one on.
				"noBannedTypes": "error",
				"noExtraBooleanCast": "error",
				"noUselessCatchBinding": "error",
				"noUselessReturn": "error",
				"noUselessStringConcat": "error",
				"noUselessUndefined": "error",
				// OFF, deliberately. All 26 sites are `void somePromise()`, which is the agreed marker for a
				// deliberately un-awaited promise (dispose, shutdown, a detached turn). Removing the operator
				// turns each one into a floating promise - the thing typescript-eslint's no-floating-promises
				// asks you to write `void` in front of - and the alternative is `.catch(() => {})` noise at
				// every call site. The rule targets `void 0` and the operator-as-expression trick, neither of
				// which appears here.
				"noVoid": "off",
				"useArrayFind": "error",
				"useLiteralKeys": "error",
				"useOptionalChain": "error",
				// OFF, deliberately. It rewrites a guard's negation into De Morgan's dual, and every one
				// of the 49 sites it reported here got harder to read for it:
				//     if (!stdout || !stderr || !stdin)   ->   if (!((stdout && stderr ) && stdin))
				// The transformation is sound and the result is worse, including the stray spacing, which
				// is the opposite of what this gate is for. Measured, rejected, recorded.
				"useSimplifiedLogicExpression": "off"
			},
			"suspicious": {
				// 151 today over the five gated trees: visible, and scripts/check-quality.mjs ratchets the
				// count down. 45 of them are `globalThis as any` on a `__PI_*__` key, which a typed global
				// augmentation would clear in one move.
				"noExplicitAny": "warn",
				// 10 call sites today; flips to "error" in the commit that removes the last one (P1/C2.2),
				// because console output lands inside a live TUI.
				"noConsole": "warn",
				// Zero after this commit, and all three are cheap to keep: `isNaN` coerces its argument
				// ("foo" is NaN, so isNaN("foo") is true), an implicitly-any `let` is an untyped binding,
				// and an assignment inside a condition reads as a comparison.
				"noGlobalIsNan": "error",
				"noImplicitAnyLet": "error",
				"noAssignInExpressions": "error",
				// noShadow and noReturnAssign - and noMultiAssign and useBlockStatements in "style" below - are
				// "error" on agy-acp/src (the override at the foot of this file, where they measure 0) and "warn"
				// everywhere else, where they are debt the ratchet in scripts/check-quality.mjs counts down.
				// "warn" is not a softer opinion: biome exits 0 on warnings, and an "error" outside agy-acp/src
				// would make `npm run lint` red on day one and take the gate's own biome measurement down with it
				// (it refuses to read counts out of a non-zero run). The per-tree counts below were taken on
				// 2026-11-04, before plugins/ joined the lint scope; scripts/quality-baseline.json holds the
				// authoritative totals.
				//
				// noShadow: 2 in agy-acp/src (server.ts's session/new - an inner `params` shadowing the
				// handler's own, next to a closure reading a `const` declared two statements later),
				// 46 in extensions, 10 in agy-acp/test, 9 in test, 5 in scripts.
				"noShadow": "warn",
				// noReturnAssign: 3 in agy-acp/src (`new Promise((r) => (host.pending = {...}))` - an
				// assignment worth seeing), 5 in agy-acp/test, 7 in test, 0 in extensions.
				"noReturnAssign": "warn"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error",
				// `[^]` matches every character including newlines, which is correct but reads as a typo
				// for `[]` (which matches nothing). Rewritten to `[\s\S]`, which says it out loud.
				"noEmptyCharacterClassInRegex": "error",
				"noUnsafeOptionalChaining": "error"
			},
			// Measured over agy-acp/src with `rules.preset: "all"` (657 diagnostics, 38 rules) and kept only
			// where the hits were real - see docs/agy-acp-code-quality-review.md 4 for the counts.
			//
			// Rejected, with the measurement rather than a preference:
			//   suspicious/noUnnecessaryConditions   23 hits, 0 true positives. It is flow-insensitive on a
			//                                        field initialised `false`, so every `if (this.disposed)
			//                                        return` idempotency guard is a hit - and the two
			//                                        conditions that ARE dead (bridge-server.ts's
			//                                        conversation check, permission.ts's plan-mode guard)
			//                                        are not among them.
			//   style/noPropertyAccessFromIndexSignature (tsc)  170 in src, 382 in test: every process.env.X.
			//   style/useNamingConvention            112 hits: the agy wire fields are snake_case by contract.
			//   style/noTernary 81, style/noMagicNumbers 24, correctness/noNodejsModules 21,
			//   style/noProcessEnv 13: cost without signal in a Node server.
			//   correctness/useQwikValidLexicalScope 16: a framework this repo does not use.
			//   style/useErrorCause                  7 hits, all false after the fix. Probed directly: the rule
			//                                        reads ErrorOptions at argument index 1, so
			//                                        `new Error(m, {cause})` and a `MyError(m, options)`
			//                                        subclass both pass, while agy-acp's code-first
			//                                        `RpcError(code, message, {cause})` cannot - the options
			//                                        are at index 2. Reordering to message-first to satisfy a
			//                                        linter would be the tail wagging the dog, so the 7 sites
			//                                        pass their cause and test-jsonrpc.ts is the guard.
			// (performance/noAwaitInLoops and performance/noNamespaceImport were rejected for agy-acp/src on
			// the same grounds; the wider survey above keeps them as ratcheted warnings instead.)
			"style": {
				// Zero, and held there. A `!` is an assertion the type system cannot check, so each one is a
				// place a refactor turns into a runtime TypeError with nothing failing at compile time. The
				// five in production code became real guards; the 37 in tests became test/helpers/must.ts,
				// which names what was missing instead of reporting it as a property of undefined.
				"noNonNullAssertion": "error",
				"useTemplate": "error",
				"useNodejsImportProtocol": "error",
				// noMultiAssign: 1 in agy-acp/src (`this.pendingProbe = this.probePromise = null`).
				"noMultiAssign": "warn",
				// useBlockStatements: 183 in agy-acp/src, every one autofixable, and what makes
				// `if (pid !== undefined) try { ... }` - an unbraced `if` whose body is a bare try
				// statement - impossible to write again. 473 in extensions, 164 in agy-acp/test,
				// 144 in test, 131 in scripts: a tree-wide autofix is P2 work, not this change.
				"useBlockStatements": "warn"
			}
		}
	},
	"overrides": [
		{
			// agy-acp/src is the one tree where the four rules above measure 0, so it is the one tree where
			// they are a gate rather than a count: `npm run lint` fails on a new hit here. agy-acp/test is
			// not included - its 179 hits are debt the ratchet counts, and fixing them is not what this
			// change is for. Keep this list as the trees that are actually clean; widening it to a tree with
			// hits turns `npm run lint` red and stops the biome half of the ratchet from measuring anything.
			"includes": ["agy-acp/src/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noShadow": "error",
						"noReturnAssign": "error"
					},
					"style": {
						"noMultiAssign": "error",
						"useBlockStatements": "error"
					}
				}
			}
		},
		{
			// ANSI stripping *is* control characters, so these regexes have to contain them. One override
			// rather than eleven `// biome-ignore` comments, which can drift away from the file they sit in.
			// test-devin-permissions.ts is the same case from the other side: it asserts that quoted
			// Devin-supplied text carries no raw escape, bidi override or line break, so the control
			// characters are the subject of the test.
			"includes": ["extensions/lib/delegate/diagnostics.ts", "test/test-delegate-permissions.ts", "test/test-delegate-diagnostics.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noControlCharactersInRegex": "off"
					}
				}
			}
		},
		{
			// Test harnesses, the manifest scripts and a plugin's own hook scripts report to the terminal
			// by design; they do not render inside a TUI. `npm run lint` covers all of them, so the
			// exemption has to be stated here rather than implied by what the gate happens to look at.
			//
			// `plugins/*/src/**` is deliberately NOT here. Its one file is an MCP server speaking JSON-RPC
			// over stdio, so a stray console.log corrupts the protocol stream and breaks tool listing for
			// anyone who installed the plugin - the failure `noStdioWrites` guards in extensions/ and
			// `agyStdoutFramesOnly` guards in agy-acp/, neither of which reaches a plugin's own src. Its
			// single legitimate console.error carries a biome-ignore naming that reason instead.
			//
			// noExplicitAny is listed for the .mjs trees too. It cannot fire there (no annotations to
			// write), so it costs nothing; it is here for the day one of them becomes .ts.
			"includes": ["test/**", "scripts/**", "agy-acp/test/**", "plugins/*/scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			// A test file's shape is dictated by what it sets up, and a fixture table or a long scenario
			// is clearer as one function than split to satisfy a line count. The rules that measure
			// production structure do not measure this.
			"includes": ["test/**", "agy-acp/test/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		}
	]
}
