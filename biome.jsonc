{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"extensions/**",
			"agy-acp/**",
			"test/**",
			"scripts/**",
			// A plugin's own code: hook scripts and the MCP server it ships. `plugins/*/lib/**` is
			// deliberately absent - those files are byte-identical vendored copies of extensions/lib/,
			// kept honest by scripts/sync-plugin-libs.mjs and gated by `npm run validate`. Linting them
			// would count the same debt twice and report every fix at two call sites.
			"plugins/*/scripts/**",
			"plugins/*/src/**",
			// Generated by `npm run qa:baseline`: its shape is whatever JSON.stringify produces, and a
			// formatter restyling a data file is noise in the one file whose diff must stay readable.
			"!scripts/quality-baseline.json",
			// The spike's prototype files are the recorded behavioural specification, not repo code:
			// reformatting or re-linting them would edit the record they are.
			"!agy-acp/test/fixtures/reference/**"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 140
	},
	"assist": {
		"enabled": false,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			// Rules below are grouped by what they cost to keep, not by what they catch:
			//
			//   "error"  - the repo is at zero today, so the gate holds the line for free. A new
			//              violation is a new decision, and it fails the build rather than growing
			//              a count nobody reads.
			//   "warn"   - real debt that exists today. `npm run check` ratchets each count against
			//              scripts/quality-baseline.json, so these may only shrink.
			//   "off"    - measured, judged to cost more than it returns, and the reason recorded.
			//
			// Severities were set from a full survey of all 56 performance/complexity rules over
			// extensions/, agy-acp/, test/, scripts/ and the plugins' own code, not from defaults.
			"performance": {
				// Zero today. noAccumulatingSpread is the O(n^2) `[...acc, x]` reduce, which is the one
				// performance mistake in this codebase's shape that would actually hurt at runtime.
				"noAccumulatingSpread": "error",
				"noDynamicNamespaceImportAccess": "error",
				// OFF, deliberately. The rule is about hidden-class deoptimisation, which needs a hot path to
				// matter; all 16 sites here are one-shot teardown. 13 are `delete (globalThis as any).__PI_*__`,
				// where the fix (`= undefined`) would leave the key on globalThis forever instead of removing
				// it - the opposite of the ownership the globalThisOwnership invariant exists to enforce. The
				// other 3 drop a section from `event.systemPromptOptions.sections`, where an `undefined` left
				// behind is a section serialised into the system prompt. Measured, rejected, recorded.
				"noDelete": "off",
				// 90 sites, and most are deliberate: cleanup that must finish in order, and `gh` calls
				// paced to stay inside GitHub's rate limit. Parallelising them is a behaviour change,
				// so this is debt to argue site by site, not a switch to flip.
				"noAwaitInLoops": "warn",
				// 446 sites, 211 of them in test/. A regex literal rebuilt per call is a real cost in a
				// hot path and noise everywhere else; warn keeps it visible and ratcheted.
				"useTopLevelRegex": "warn",
				// 189 sites, nearly all `import * as path from "node:path"`. The rule exists to help a
				// bundler tree-shake, which this repo never does: Pi loads these files directly. Kept
				// visible rather than off because a namespace import of a *local* module is worth seeing.
				"noNamespaceImport": "warn"
			},
			"complexity": {
				// 51 functions above 20 today (P1 decision D3b): reported here, ratcheted by check-quality,
				// instead of a hand-rolled "lines per declaration" counter.
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": {
						"maxAllowedComplexity": 20
					}
				},
				// biome's default of 50 lines reports 107 functions, including the five extension entry
				// points at 1913, 1590, 1237, 1187 and 1091 lines. The limit is set where it separates
				// "long" from "the whole extension is one function", and the count is ratcheted down.
				"noExcessiveLinesPerFunction": {
					"level": "warn",
					"options": {
						"maxLines": 120,
						"skipBlankLines": true
					}
				},
				// No function anywhere takes more than 6 parameters, so 6 is the line already held.
				// biome's default of 4 would have reported 34 call signatures as debt on day one.
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 6
					}
				},
				// Zero today, kept that way.
				"noAdjacentSpacesInRegex": "error",
				"noArguments": "error",
				"noCommaOperator": "error",
				"noDivRegex": "error",
				"noEmptyTypeParameters": "error",
				"noExcessiveNestedTestSuites": "error",
				"noFlatMapIdentity": "error",
				"noForEach": "error",
				"noImplicitCoercions": "error",
				"noRedundantDefaultExport": "error",
				"noStaticOnlyClass": "error",
				"noThisInStatic": "error",
				"noUselessCatch": "error",
				"noUselessConstructor": "error",
				"noUselessContinue": "error",
				"noUselessEmptyExport": "error",
				"noUselessEscapeInRegex": "error",
				"noUselessLabel": "error",
				"noUselessLoneBlockStatements": "error",
				"noUselessRename": "error",
				"noUselessStringRaw": "error",
				"noUselessSwitchCase": "error",
				"noUselessTernary": "error",
				"noUselessThisAlias": "error",
				"noUselessTypeConstraint": "error",
				"noUselessUndefinedInitialization": "error",
				"useArrowFunction": "error",
				"useDateNow": "error",
				"useFlatMap": "error",
				"useIndexOf": "error",
				"useNumericLiterals": "error",
				"useRegexLiterals": "error",
				"useSimpleNumberKeys": "error",
				"useWhile": "error",
				// Small counts, fixed in the commit that turned each one on.
				"noBannedTypes": "error",
				"noExtraBooleanCast": "error",
				"noUselessCatchBinding": "error",
				"noUselessReturn": "error",
				"noUselessStringConcat": "error",
				"noUselessUndefined": "error",
				// OFF, deliberately. All 26 sites are `void somePromise()`, which is the agreed marker for a
				// deliberately un-awaited promise (dispose, shutdown, a detached turn). Removing the operator
				// turns each one into a floating promise - the thing typescript-eslint's no-floating-promises
				// asks you to write `void` in front of - and the alternative is `.catch(() => {})` noise at
				// every call site. The rule targets `void 0` and the operator-as-expression trick, neither of
				// which appears here.
				"noVoid": "off",
				"useArrayFind": "error",
				"useLiteralKeys": "error",
				"useOptionalChain": "error",
				// OFF, deliberately. It rewrites a guard's negation into De Morgan's dual, and every one
				// of the 56 sites it reported here got harder to read for it:
				//     if (!stdout || !stderr || !stdin)   ->   if (!((stdout && stderr ) && stdin))
				// The transformation is sound and the result is worse, including the stray spacing, which
				// is the opposite of what this gate is for. Measured, rejected, recorded.
				"useSimplifiedLogicExpression": "off"
			},
			"suspicious": {
				// 147 today: visible, and scripts/check-quality.mjs ratchets the count down.
				"noExplicitAny": "warn",
				// 17 call sites today; flips to "error" in the commit that removes the last one (P1/C2.2),
				// because console output lands inside a live TUI.
				"noConsole": "warn",
				// Zero after this commit, and all three are cheap to keep: `isNaN` coerces its argument
				// ("foo" is NaN, so isNaN("foo") is true), an implicitly-any `let` is an untyped binding,
				// and an assignment inside a condition reads as a comparison.
				"noGlobalIsNan": "error",
				"noImplicitAnyLet": "error",
				"noAssignInExpressions": "error"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error",
				// `[^]` matches every character including newlines, which is correct but reads as a typo
				// for `[]` (which matches nothing). Rewritten to `[\s\S]`, which says it out loud.
				"noEmptyCharacterClassInRegex": "error",
				"noUnsafeOptionalChaining": "error"
			},
			"style": {
				// Zero, and held there. A `!` is an assertion the type system cannot check, so each one is a
				// place a refactor turns into a runtime TypeError with nothing failing at compile time. The
				// five in production code became real guards; the 37 in tests became test/helpers/must.ts,
				// which names what was missing instead of reporting it as a property of undefined.
				"noNonNullAssertion": "error",
				"useTemplate": "error",
				"useNodejsImportProtocol": "error"
			}
		}
	},
	"overrides": [
		{
			// ANSI stripping *is* control characters, so these regexes have to contain them. One override
			// rather than eleven `// biome-ignore` comments, which can drift away from the file they sit in.
			// test-devin-permissions.ts is the same case from the other side: it asserts that quoted
			// Devin-supplied text carries no raw escape, bidi override or line break, so the control
			// characters are the subject of the test.
			"includes": ["extensions/lib/devin-diagnostics.ts", "test/test-devin-permissions.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noControlCharactersInRegex": "off"
					}
				}
			}
		},
		{
			// Test harnesses, the manifest scripts and a plugin's own hook scripts report to the terminal
			// by design; they do not render inside a TUI. `npm run lint` covers all of them, so the
			// exemption has to be stated here rather than implied by what the gate happens to look at.
			"includes": ["test/**", "scripts/**", "agy-acp/test/**", "plugins/*/scripts/**", "plugins/*/src/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			// A test file's shape is dictated by what it sets up, and a fixture table or a long scenario
			// is clearer as one function than split to satisfy a line count. The rules that measure
			// production structure do not measure this.
			"includes": ["test/**", "agy-acp/test/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		}
	]
}
